# GEMINI_API_KEY: Required for Gemini AI API calls.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# RailRadar API for real-time live train tracking, PNR status, schedule & station boards
RAILRADAR_API_KEY=MY_RAILRADAR_API_KEY

# MapTiler API for high-resolution interactive map tiles and train route rendering
MAPTILER_API_KEY=MY_MAPTILER_API_KEY
NEXT_PUBLIC_MAPTILER_API_KEY=MY_MAPTILER_API_KEY

# OpenWeather API for real-time station weather & forecast along route
OPENWEATHER_API_KEY=MY_OPENWEATHER_API_KEY

# OpenTopography API for elevation profiles along railway corridors
OPENTOPOGRAPHY_API_KEY=MY_OPENTOPOGRAPHY_API_KEY

# Upstash Redis for high-speed live tracking cache
UPSTASH_REDIS_REST_URL=MY_UPSTASH_REDIS_REST_URL
UPSTASH_REDIS_REST_TOKEN=MY_UPSTASH_REDIS_REST_TOKEN
